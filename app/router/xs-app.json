{
  "welcomeFile": "index.html",
  "authenticationMethod": "route",

  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/whoami/(.*)$",
      "target": "/whoami/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "public",
      "authenticationType": "xsuaa"
    }
  ]
}
