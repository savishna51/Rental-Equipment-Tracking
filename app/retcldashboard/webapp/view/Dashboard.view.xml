<mvc:View
    controllerName="com.retcl.dashboard.retcldashboard.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <App id="dashboardApp">

        <pages>

            <Page
                id="dashboardPage"
                title="RETCL Dashboard">

              <content>

    <VBox id="mainVBox">

        <!-- <Title
            id="dashboardTitle"
            text="Good Morning, RETCL Team" /> -->

        <HBox
            id="kpiHBox"
            wrap="Wrap">

            <GenericTile
                id="fleetTile"
                header="Active Fleet"
                subheader="Equipment"
                press=".onFleetPress">


                <tileContent>
                    <TileContent id="fleetContent">
                        <content>
                            <NumericContent
                                id="fleetCount"/>
                        </content>
                    </TileContent>
                </tileContent>

            </GenericTile>

            <GenericTile
                id="inspectionTile"
                header="Open Inspections"
                subheader="Pending"
                press=".onInspectionPress">

                <tileContent>
                    <TileContent id="inspectionContent">
                        <content>
                            <NumericContent
                                id="inspectionCount" />
                        </content>
                    </TileContent>
                </tileContent>

            </GenericTile>

            <GenericTile
                id="rentalTile"
                header="Active Rentals"
                subheader="Current"
                press=".onRentalPress">

                <tileContent>
                    <TileContent id="rentalContent">
                        <content>
                            <NumericContent
                                id="rentalCount"/>
                        </content>
                    </TileContent>
                </tileContent>

            </GenericTile>

            <GenericTile
                id="billingTile"
                header="Repair Bills"
                subheader="Open"
                press=".onBillingPress">

                <tileContent>
                    <TileContent id="billingContent">
                        <content>
                            <NumericContent
                                id="billingCount"/>
                        </content>
                    </TileContent>
                </tileContent>

            </GenericTile>

        </HBox>

        <Panel
    id="fleetPanel"
    headerText="Fleet Utilization"
    class="sapUiMediumMarginTop">

    <VBox
    id="FleetVBox"
    class="sapUiMediumMargin">

    <Title
        id="utilizationValue"
        text="86.2%" />

    <Text
        id="utilizationGrowth"
        text="+4.6% vs previous period" />

</VBox>

    <viz:VizFrame
    id="fleetChart"
    vizType="area"
    width="100%"
    height="350px"/>

</Panel>

<Panel
    id="billingHealthPanel"
    headerText="Billing Health"
    class="sapUiMediumMarginTop">

    <HBox
        id="billingHBox"
        justifyContent="Center"
        alignItems="Center">

        <viz:VizFrame
            id="billingChart"
            vizType="donut"
            width="400px"
            height="350px"/>

        <VBox
            id="billingSummaryVBox"
            class="sapUiLargeMarginBegin">

            <Title
                id="billingAmount"
                text="$89,240"/>

            <Text
                id="eligibleCharges"
                text="Eligible Charges"/>

            <Text
                id="postedAmount"
                text="🟢 Posted: $84,600"/>

            <Text
                id="pendingAmount"
                text="🟠 Pending: $4,640"/>

        </VBox>

    </HBox>

</Panel>

<Panel
    id="inspectionQueuePanel"
    headerText="Inspection Queue"
    class="sapUiMediumMarginTop">

    <Table id="inspectionTable">

        <columns>

            <Column id="equipmentColumn">
                <Text
                    id="equipmentColumnText"
                    text="Equipment"/>
            </Column>

            <Column id="damageColumn">
                <Text
                    id="damageColumnText"
                    text="Damage"/>
            </Column>

            <Column id="conditionColumn">
                <Text
                    id="conditionColumnText"
                    text="Condition"/>
            </Column>

        </columns>

        <items>

            <ColumnListItem id="inspectionRow1">

                <cells>

                    <Text
                        id="equipment1"
                        text="CAT320 Excavator"/>

                    <Text
                        id="damage1"
                        text="Hydraulic Arm Dent"/>

                    <ObjectStatus
                        id="status1"
                        text="Open"
                        state="Error"/>

                </cells>

            </ColumnListItem>

            <ColumnListItem id="inspectionRow2">

                <cells>

                    <Text
                        id="equipment2"
                        text="JLG Boom Lift"/>

                    <Text
                        id="damage2"
                        text="Guard Rail Damage"/>

                    <ObjectStatus
                        id="status2"
                        text="Review"
                        state="Warning"/>

                </cells>

            </ColumnListItem>

        </items>

    </Table>

</Panel>

<Panel
    id="activityPanel"
    headerText="Activity Feed"
    class="sapUiMediumMarginTop">

    <List id="activityList">

        <StandardListItem
            id="activity1"
            title="Asset Returned"/>

        <StandardListItem
            id="activity2"
            title="New Damage Reported"/>

        <StandardListItem
            id="activity3"
            title="Repair Bill Generated"/>

        <StandardListItem
            id="activity4"
            title="Rental Completed"/>

    </List>

</Panel>

    </VBox>

</content>

            </Page>

        </pages>

    </App>

</mvc:View>